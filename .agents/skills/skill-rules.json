{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Rules Configuration",
  "description": "Defines trigger rules for automatic skill activation based on keywords, patterns, and file paths.",
  "rules": [
    {
      "skill": "shell-script-quality",
      "triggers": {
        "keywords": [
          "shell",
          "bash",
          "script",
          "shellcheck",
          "bats"
        ],
        "patterns": [
          "\\.sh$",
          "^(#!.*bash)",
          "^(#!.*sh)"
        ],
        "files": [
          "**/*.sh",
          "scripts/**/*"
        ]
      },
      "priority": "high",
      "autoActivate": true
    },
    {
      "skill": "goap-agent",
      "triggers": {
        "keywords": [
          "plan",
          "decompose",
          "break down",
          "steps",
          "phases",
          "milestone"
        ],
        "patterns": [
          "plan.*",
          "step.*",
          "phase.*"
        ],
        "files": []
      },
      "priority": "high",
      "autoActivate": true
    },
    {
      "skill": "test-runner",
      "triggers": {
        "keywords": [
          "test",
          "spec",
          "coverage",
          "unit test",
          "integration test"
        ],
        "patterns": [
          "test.*",
          "spec.*",
          ".*_test\\.",
          ".*\\.test\\."
        ],
        "files": [
          "**/tests/**/*",
          "**/*.test.*",
          "**/*_test.*"
        ]
      },
      "priority": "high",
      "autoActivate": true
    },
    {
      "skill": "agent-coordination",
      "triggers": {
        "keywords": [
          "parallel",
          "concurrent",
          "simultaneous",
          "batch",
          "coordinate",
          "swarm"
        ],
        "patterns": [
          "parallel.*",
          "concurrent.*",
          "coordinate.*"
        ],
        "files": []
      },
      "priority": "medium",
      "autoActivate": false
    },
    {
      "skill": "iterative-refinement",
      "triggers": {
        "keywords": [
          "iterate",
          "refine",
          "improve",
          "loop",
          "progressive"
        ],
        "patterns": [
          "iterate.*",
          "refine.*",
          "improve.*"
        ],
        "files": []
      },
      "priority": "medium",
      "autoActivate": false
    },
    {
      "skill": "ui-ux-optimize",
      "triggers": {
        "keywords": [
          "UI",
          "UX",
          "design",
          "interface",
          "layout",
          "responsive",
          "dashboard",
          "game UI",
          "navigation",
          "design tokens",
          "wireframe",
          "prototype",
          "redesign",
          "mobile design",
          "web design"
        ],
        "patterns": [
          "design.*interface",
          "UI.*UX",
          "responsive.*layout",
          "design.*system",
          "optimize.*prompt"
        ],
        "files": []
      },
      "priority": "high",
      "autoActivate": true
    },
    {
      "skill": "accessibility-auditor",
      "triggers": {
        "keywords": [
          "accessibility",
          "a11y",
          "WCAG",
          "screen reader",
          "keyboard navigation",
          "color contrast",
          "ARIA",
          "Section 508",
          "ADA compliance",
          "alt text",
          "focus order"
        ],
        "patterns": [
          "accessibility.*",
          "a11y.*",
          "wcag.*",
          "contrast.*",
          "aria.*"
        ],
        "files": [
          "**/*.html",
          "**/*.jsx",
          "**/*.tsx",
          "**/*.vue",
          "**/*.css",
          "**/*.scss"
        ]
      },
      "priority": "high",
      "autoActivate": true
    },
    {
      "skill": "web-search-researcher",
      "triggers": {
        "keywords": [
          "search",
          "research",
          "find information",
          "look up",
          "documentation"
        ],
        "patterns": [
          "search.*",
          "research.*",
          "find.*"
        ],
        "files": []
      },
      "priority": "medium",
      "autoActivate": false
    },
    {
      "skill": "css-render-performance",
      "triggers": {
        "keywords": [
          "will-change",
          "animation performance",
          "scroll jank",
          "jank",
          "reflow",
          "repaint",
          "content-visibility",
          "CSS contain",
          "compositor layer",
          "render optimization",
          "paint cost",
          "GPU acceleration",
          "layer explosion",
          "transform animation"
        ],
        "patterns": [
          "animation.*performance",
          "scroll.*jank",
          "will-change"
        ],
        "files": [
          "**/*.css",
          "**/*.scss",
          "**/*.html",
          "**/*.jsx",
          "**/*.tsx",
          "**/*.vue"
        ]
      },
      "priority": "high",
      "autoActivate": true
    },
    {
      "skill": "codacy",
      "triggers": {
        "keywords": [
          "codacy",
          "code quality",
          "static analysis",
          "lint analysis",
          "code coverage",
          "quality gate"
        ],
        "patterns": [
          "codacy.*",
          "quality.*gate",
          "code.*quality"
        ],
        "files": [
          ".codacy.yaml",
          ".codacy.yml"
        ]
      },
      "priority": "high",
      "autoActivate": true
    },
    {
      "skill": "code-review-assistant",
      "triggers": {
        "keywords": [
          "review",
          "code review",
          "pr review",
          "pull request review",
          "review comments"
        ],
        "patterns": [
          "review.*pr",
          "review.*pull",
          "code.*review"
        ],
        "files": []
      },
      "priority": "high",
      "autoActivate": true
    },
    {
      "skill": "agentic-abstention",
      "triggers": {
        "keywords": [
          "abstain",
          "stopping rules",
          "stop acting",
          "infeasible",
          "give up",
          "halt"
        ],
        "patterns": [
          "stop.*act",
          "abstain.*",
          "infeasib.*"
        ],
        "files": []
      },
      "priority": "medium",
      "autoActivate": false
    },
    {
      "skill": "cicd-pipeline",
      "triggers": {
        "keywords": [
          "ci",
          "cd",
          "pipeline",
          "workflow",
          "github actions",
          "gitlab ci",
          "forgejo",
          "coverage upload"
        ],
        "patterns": [
          "ci.*cd",
          "pipeline.*",
          "workflow.*",
          "github.*actions",
          "gitlab.*ci"
        ],
        "files": [
          ".github/workflows/*.yml",
          ".gitlab-ci.yml",
          ".forgejo/workflows/*.yml"
        ]
      },
      "priority": "high",
      "autoActivate": true
    }
  ],
  "settings": {
    "maxSkillsPerTask": 3,
    "cooldownPeriod": 300,
    "requireUserConfirmation": false
  }
}