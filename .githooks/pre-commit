#!/usr/bin/env bash
# Git pre-commit hook (installed via core.hooksPath = .githooks).
# Delegates to scripts/pre-commit-hook.sh for shared logic; the gate
# implementation stays in scripts/ so it is linted like all other sources.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
exec "$REPO_ROOT/scripts/pre-commit-hook.sh" "$@"
